# Public-safe defaults. Copy to .env and replace secrets and deployment paths.
APP_NAME=Metis
APP_DESCRIPTION=A private, configurable AI agent workspace.
PORT=3100
# Bind address for the web UI and MCP port. Use 0.0.0.0 for LAN access.
# Docker: after editing, run ./reload.sh (`docker compose restart` is not enough).
AI_CHAT_HOST=127.0.0.1
AI_CHAT_BIND=127.0.0.1
# Forwarding headers are ignored unless the actual socket peer matches these
# comma-separated IPs/CIDRs. Example for a local Nginx: 127.0.0.1,::1
# Only trust controlled proxies that overwrite X-Forwarded-For/Proto.
AI_CHAT_TRUSTED_PROXIES=
# Additional exact browser-stream origins, comma-separated (no wildcards).
AI_CHAT_BROWSER_ALLOWED_ORIGINS=
# First-run token is generated in CHAT_DATA_DIR/setup-token with private rights.
# Optional operator-supplied random secret (at least 32 characters):
# AI_CHAT_SETUP_TOKEN=
# Root execution is enabled for Host-Admins with workspaces inside the root home.
# Set false to disable root agents.
AI_CHAT_ALLOW_ROOT_AGENTS=true
CHAT_USERNAME=admin
CHAT_PASSWORD=replace-with-a-long-random-password
CHAT_DATA_DIR=./data
AGENT_CWD=.
AI_CHAT_ROOT=.
AI_CHAT_INSTALL_DIR=.
AI_CHAT_PUBLIC_URL=http://127.0.0.1:3100
AI_CHAT_INTERNAL_ORIGIN=http://127.0.0.1:3100
AI_CHAT_SERVICE_NAME=metis-ai
AI_CHAT_WORKER_CONCURRENCY=25
AI_CHAT_WORKER_POLL_MS=500
AI_CHAT_WORKER_MAX_JOB_MS=1800000
# Optional provider silence limits (ms): token streams 3m, buffered SDKs 15m,
# active tools 30m. The global override applies to both stream types unless
# AI_CHAT_PROVIDER_BUFFERED_IDLE_MS is also set. Cancellation stays immediate.
# AI_CHAT_PROVIDER_IDLE_MS=180000
# AI_CHAT_PROVIDER_BUFFERED_IDLE_MS=900000
# AI_CHAT_PROVIDER_TOOL_IDLE_MS=1800000
AI_CHAT_MCP_STATE_DIR=./data/mcp-state
AI_CHAT_INTERNAL_URL=http://127.0.0.1:3100/api/internal/mcp-question
AI_CHAT_WORKSPACE_URL=http://127.0.0.1:3100/api/internal/mcp-workspace
AI_CHAT_CHAT_URL=http://127.0.0.1:3100/api/internal/mcp-chat
AI_CHAT_NOTES_URL=http://127.0.0.1:3100/api/internal/mcp-notes
AI_CHAT_MEMORY_URL=http://127.0.0.1:3100/api/internal/mcp-memory
AI_CHAT_BROWSER_URL=http://127.0.0.1:3100/api/internal/browser
AI_CHAT_AGENT_STATE_URL=http://127.0.0.1:3100/api/internal/mcp-agent-state
AI_CHAT_SUBAGENT_URL=http://127.0.0.1:3100/api/internal/mcp-subagent
AI_CHAT_AUTOMATION_URL=http://127.0.0.1:3100/api/internal/mcp-automation
AI_CHAT_FILE_URL=http://127.0.0.1:3100/api/internal/mcp-file

MCP_PORT=8787
MCP_PUBLIC_URL=http://127.0.0.1:8787
MCP_BEARER_TOKEN=replace-with-a-long-random-token
MCP_ALLOW_REMOTE_ADMIN=false
MCP_ENABLE_REMOTE_SERVERS=false
MCP_ENABLE_OPTIONAL_SERVERS=false
MCP_LOCAL_SEARCH_URL=http://127.0.0.1:8888/search
MCP_LOCAL_SCRAPER_URL=http://127.0.0.1:8890/fetch
MCP_LOCAL_SCRAPER_SEARCH_URL=http://127.0.0.1:8890/search

# Comma-separated private/local base URLs explicitly approved by the host
# administrator for voice transcription, for example http://127.0.0.1:9000/v1
VOICE_TRANSCRIPTION_PRIVATE_BASE_URLS=

# METIS_DOCKER=false

# Optional integrations:
# AI_CHAT_SECRETS_KEY=64-hex-characters-or-32-byte-base64-key
# CODEX_HOME=/home/your-user/.codex
# ANTIGRAVITY_PYTHON=python3
# MCP_SDK_ROOT=
# ACCOUNT_ADMIN_TOKEN=
